{
  "watch_folders": [],
  "target_base": "",
  "download_complete_wait": 5,
  "batch_window": 15,
  "batch_max_wait": 300,
  "settle_window": 3,
  "poll_interval": 2,
  "file_max_wait": 1800,
  "offline_hold_seconds": 600,
  "hash_chunk_size": 8388608,
  "min_file_size_for_hash": 1024,
  "default_category": "其他",
  "time_saving": false,
  "duplicate_action": "quarantine",
  "hard_delete_duplicates": false,
  "categories": {
