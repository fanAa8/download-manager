      "extensions": [".jpg", ".jpeg", ".jpe", ".jfif", ".png", ".gif", ".bmp", ".webp", ".svg", ".ico", ".tiff", ".tif", ".psd", ".psb", ".ai", ".eps", ".raw", ".cr2", ".cr3", ".nef", ".arw", ".dng", ".orf", ".rw2", ".raf", ".pef", ".heic", ".heif", ".avif", ".wmf", ".emf", ".dds", ".tga", ".exr", ".hdr", ".pcx", ".jxl", ".jp2", ".apng"]
