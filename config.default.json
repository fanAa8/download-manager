      "role": "video",
      "extensions": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".flv", ".webm", ".m4v", ".ts", ".mts", ".m2ts", ".m2v", ".vob", ".mpg", ".mpeg", ".3gp", ".3g2", ".rm", ".rmvb", ".divx", ".f4v", ".asf", ".swf", ".ogv", ".m3u8", ".wtv", ".dvr-ms"]
    },
    "音乐": {
      "role": "music",
      "extensions": [".mp3", ".flac", ".wav", ".aac", ".ogg", ".wma", ".m4a", ".m4b", ".ape", ".opus", ".alac", ".aiff", ".aif", ".mid", ".midi", ".ac3", ".dts", ".wv", ".tak", ".pcm", ".dff", ".dsf", ".cue", ".lrc", ".m3u", ".oga", ".mka", ".tta", ".mpc", ".spx"]
    },
    "图片": {
